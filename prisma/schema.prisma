datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  phone     String?   @unique
  role      String    @default("CUSTOMER") // CUSTOMER, ADMIN
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  tagline          String
  description      String
  category         String           // Living, Dining, Bedroom, Executive, Bespoke
  dimensions       String
  warranty         String           @default("10 Years Structural Warranty")
  careInstructions String           @default("Clean with soft dry microfibre cloth. Avoid direct intense heat.")
  featured         Boolean          @default(false)
  basePrice        Float
  images           String           // JSON string of image URLs
  hsnCode          String           @default("9403")
  variants         ProductVariant[]
  reviews          Review[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  colorName     String
  colorHex      String
  material      String
  priceOverride Float?
  stock         Int      @default(5)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // FLAT or PERCENT
  value         Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  validFrom     DateTime  @default(now())
  validTo       DateTime
  usageLimit    Int       @default(100)
  timesUsed     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  status            String      @default("PAID") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, RETURN_REQUESTED, RETURNED, REFUNDED, CANCELLED
  subtotal          Float
  discount          Float       @default(0)
  gstRate           Float       @default(0.18)
  cgst              Float       @default(0)
  sgst              Float       @default(0)
  igst              Float       @default(0)
  totalAmount       Float
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  trackingNumber    String?
  courierName       String?
  shippingAddress   String      // JSON string of address details
  buyerGstin        String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  variantId      String?
  productName    String
  variantSummary String
  quantity       Int
  unitPrice      Float
  totalPrice     Float
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  authorName       String
  rating           Int      @default(5)
  comment          String
  verifiedPurchase Boolean  @default(true)
  status           String   @default("APPROVED") // PENDING, APPROVED, HIDDEN
  createdAt        DateTime @default(now())
}

model WebhookEvent {
  id              String   @id @default(cuid())
  razorpayEventId String   @unique
  type            String
  payload         String
  processedAt     DateTime @default(now())
}

model ClientProject {
  id                String   @id @default(cuid())
  title             String   // e.g. "Altamount Road Penthouse Curation"
  clientName        String   // e.g. "Vikramaditya Singhania"
  location          String   // e.g. "Altamount Road, South Mumbai"
  city              String   // e.g. "Mumbai"
  roomType          String   // e.g. "Living Room Sanctuary"
  scope             String   // e.g. "Custom 12-seater Carrara table, laser alignment, Chesterfield sofa"
  artisanSupervisor String   @default("Senior Master Artisan A1")
  completionDate    String   // e.g. "February 2026"
  beforeImage       String?  // Optional before image
  images            String   // JSON array of image URLs
  featured          Boolean  @default(true)
  clientReview      String?  // Testimonial
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
